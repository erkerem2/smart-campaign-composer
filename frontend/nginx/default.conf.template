# Rendered by the nginx image's entrypoint (envsubst):
#   ${API_UPSTREAM}    host:port of the Go API          (default backend:8080)
#   ${NGINX_RESOLVER}  DNS server for that host name    (default 127.0.0.11, Docker's embedded DNS)

server {
    listen 80;
    server_name _;

    root  /usr/share/nginx/html;
    index index.html;

    # Resolve the API host per request (cached 10 s) instead of once at
    # start-up, so `docker compose up --build backend` - which gives the
    # backend container a new IP - does not leave nginx proxying to a dead one.
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
    resolver_timeout 2s;
    set $api_upstream http://${API_UPSTREAM};

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # ----------------------------------------------------------- API + SSE --
    # /api/campaigns/compose/stream and /api/campaigns/{id}/dispatch/stream
    # are Server-Sent Events: no buffering, no gzip, long read timeout. The Go
    # API also sends `X-Accel-Buffering: no`, this is belt and braces.
    location /api/ {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        gzip off;

        # The API itself rejects bodies over 256 KB with a JSON error.
        client_max_body_size 1m;
    }

    location = /healthz {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_read_timeout 5s;
    }

    location = /metrics {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_read_timeout 5s;
    }

    # --------------------------------------------------------- static SPA --
    # Vite emits content-hashed file names under /assets: cache forever.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # index.html must always be revalidated so a new build is picked up.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
