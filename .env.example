# Copy to .env and fill in. Never commit .env.
# The same file serves `docker compose` (variable interpolation) and the
# local `make run` (the server loads ../.env without overriding real env vars).

# --- LLM -----------------------------------------------------------------
# Empty = deterministic mock LLM (every brief gets the reference rule and
# content): the full flow and all tests run offline at zero cost.
ANTHROPIC_API_KEY=
# Optional, defaults to claude-sonnet-5-5
ANTHROPIC_MODEL=

# --- Backend (local `make run`) -------------------------------------------
# Under docker compose these three are fixed by docker-compose.yml
# (PROVIDER_URL=http://mock-provider:9090, DB_PATH=/data/campaign.db).
# Base URL of the SMS / e-mail provider (run it from backend/: go run ./cmd/mock-provider)
PROVIDER_URL=http://localhost:9090
# HTTP API listen address and SQLite path (relative to backend/)
HTTP_ADDR=:8080
DB_PATH=data/campaign.db
# Browser origins allowed to call the API (comma separated, or *).
# Empty = local defaults (Vite 5173/4173, 8081, 3000 on localhost/127.0.0.1).
CORS_ALLOWED_ORIGINS=
# Mock LLM only: delay between streamed fragments, for a visible typing effect
MOCK_STREAM_DELAY_MS=15

# --- docker compose: published host ports ---------------------------------
FRONTEND_PORT=3000
BACKEND_PORT=8080
MOCK_PROVIDER_PORT=9090

# --- docker compose: mock provider chaos ----------------------------------
# (local `make mock-provider` reads the same names from the shell environment)
MOCK_RATE_LIMITED_RATIO=0.10
MOCK_SERVER_ERROR_RATIO=0.05
MOCK_MIN_LATENCY=10ms
MOCK_MAX_LATENCY=30ms
MOCK_RETRY_AFTER=1s
