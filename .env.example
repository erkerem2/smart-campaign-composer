# Copy to .env and fill in. Never commit .env.
# Without a key the backend can run against the mock LLM clients.
ANTHROPIC_API_KEY=
# Optional, defaults to claude-sonnet-5-5
ANTHROPIC_MODEL=
# Base URL of the SMS / e-mail provider (run it from backend/: go run ./cmd/mock-provider)
PROVIDER_URL=http://localhost:9090
